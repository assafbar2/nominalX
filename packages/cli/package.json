{
  "name": "nominalx",
  "version": "0.1.0",
  "type": "module",
  "description": "NominalX deterministic flight-readiness CLI (check, fire, dossier, report, demo-target, demo-patch)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nominalx": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@nominalx/core": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
